# Gateway for the NCCU Moodle MCP OAuth stack.
# TLS is terminated by the tunnel (e.g. Cloudflare) in front of this, so Caddy
# serves plain HTTP on :80 and does not try to provision certificates.
#
# All routing uses `handle` blocks so they are mutually exclusive and evaluated
# in order (first match wins) — mixing bare directives with a handle fallback
# breaks precedence.
{
	admin off
	auto_https off
}

:80 {
	# --- Discovery metadata for MCP client auto-registration (served by our
	#     auth service; must come BEFORE the Hydra catch-all for /.well-known/*) ---
	handle /.well-known/oauth-authorization-server {
		reverse_proxy auth:3000
	}
	handle /.well-known/oauth-protected-resource {
		reverse_proxy auth:3000
	}

	# --- Token endpoint: proxied through our auth service, which re-wraps the
	#     Moodle token under the new access/refresh tokens, then forwards to Hydra.
	#     Must come BEFORE the /oauth2/* catch-all below. ---
	handle /oauth2/token {
		reverse_proxy auth:3000
	}

	# --- OAuth issuer endpoints (ChatGPT talks to Hydra): openid-configuration,
	#     jwks, the rest of /oauth2/* incl. /oauth2/register (DCR), /userinfo ---
	@hydra path /oauth2/* /.well-known/* /userinfo /health/*
	handle @hydra {
		reverse_proxy hydra:4444 {
			# The tunnel terminates TLS, so tell Hydra the real client scheme
			# (https in prod) — needed so its login CSRF cookie is set Secure and
			# survives the OAuth redirect. FWD_PROTO=http for local plain-http.
			header_up X-Forwarded-Proto {$FWD_PROTO:https}
		}
	}

	# --- Login / consent UI (user's browser, redirected here by Hydra) ---
	@authui path /login /login/* /consent /consent/*
	handle @authui {
		reverse_proxy auth:3000
	}

	# --- MCP endpoint: dual auth ---
	handle /mcp* {
		# Header-credential clients (e.g. Claude Code) send X-Moodle-Username /
		# X-Moodle-Password: pass straight through to the MCP server, which does
		# its own SSO login. Skip OAuth. Strip any client-supplied token headers
		# so only the real user/pass drives the backend.
		@headercreds header_regexp X-Moodle-Username .+
		handle @headercreds {
			reverse_proxy mcp:3033 {
				header_up -X-Moodle-Token
				header_up -X-Moodle-Base
			}
		}

		# Otherwise: OAuth bearer token -> verify -> inject the Moodle token.
		handle {
			forward_auth auth:3000 {
				uri /verify
				# Copy the Moodle token + base from the verify response onto the
				# request that goes upstream to the MCP server.
				copy_headers X-Moodle-Token X-Moodle-Base
			}
			reverse_proxy mcp:3033 {
				# The MCP server authenticates via the injected headers, not the
				# client's bearer token — don't forward it.
				header_up -Authorization
			}
		}
	}

	handle {
		respond "NCCU Moodle MCP gateway" 200
	}
}
