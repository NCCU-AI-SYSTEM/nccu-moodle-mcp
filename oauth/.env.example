# Copy to .env at the repo root:  cp oauth/.env.example .env
# Then fill in your values and run:
#   docker compose -f docker-compose.oauth.yml up -d --build

# The public HTTPS URL your tunnel exposes (points at the Caddy gateway).
# ChatGPT and the login page both use this. No trailing slash.
PUBLIC_URL=https://moodle-mcp.example.com

# Hydra's system secret — 32+ random chars. Generate e.g.:  openssl rand -hex 24
HYDRA_SECRET=change-me-to-a-long-random-string

# Postgres password for Hydra's database.
POSTGRES_PASSWORD=change-me

# Host port Caddy listens on (your tunnel points here). Default 8080.
GATEWAY_PORT=8080

# Redirect URI ChatGPT shows you when adding the connector (used by
# oauth/register-client.sh). Example shape:
OAUTH_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect

# Client credentials to create for ChatGPT (used by register-client.sh).
OAUTH_CLIENT_ID=chatgpt
OAUTH_CLIENT_SECRET=change-me-too
