# Copy to .env at the repo root:  cp .env.oauth.example .env
# Then fill in your values and run:
#   docker compose -f docker-compose.oauth.yml up -d --build

# The public HTTPS URL your tunnel exposes (points at the Caddy gateway).
# ChatGPT and the login page both use this. No trailing slash.
PUBLIC_URL=https://moodle-mcp.example.com

# Hydra's system secret — 32+ random chars. Generate e.g.:  openssl rand -hex 24
HYDRA_SECRET=change-me-to-a-long-random-string

# Password for Hydra's Postgres database.
POSTGRES_PASSWORD=change-me

# Host port Caddy listens on (your tunnel points here). Default 8971.
GATEWAY_PORT=8971

# Note: no client id/secret needed — MCP clients (ChatGPT) self-register via
# Dynamic Client Registration when you add the connector by URL.
